            </object>
         </patchobj>
         <obj type="logic/change" uuid="96e39ae624c3f3c952cec4a95e1986ee0104f718" name="change_12" x="406" y="42">
            <params/>
            <attribs/>
         </obj>
         <patchobj type="patch/object" uuid="8c46ef5d-87fa-459c-a88f-6abd842c6668" name="layout_13" x="490" y="42">
            <params/>
            <attribs>
               <spinner attributeName="parammsb" value="1"/>
               <spinner attributeName="paramlsb" value="6"/>
            </attribs>
            <object id="patch/object" uuid="8c46ef5d-87fa-459c-a88f-6abd842c6668">
               <sDescription>6</sDescription>
               <author>Mattilyn Mattroe</author>
               <license>give me two apple pies and a small fries evry time the object is used in an art installation at the louvre. Otherwise, do as you will</license>
               <helpPatch>LPadPro.axh</helpPatch>
               <inlets>
                  <bool32 name="send"/>
                  <int32 name="v"/>
               </inlets>
               <outlets/>
               <displays/>
               <params/>
               <attribs>
                  <spinner name="parammsb" MinValue="0" MaxValue="127" DefaultValue="0"/>
                  <spinner name="paramlsb" MinValue="0" MaxValue="127" DefaultValue="0"/>
               </attribs>
               <includes/>
               <code.declaration><![CDATA[int strig;
int v;
int msb;
int msb2;
int msb3;
int lsb;
int parammsb;
int paramlsb;]]></code.declaration>
               <code.krate><![CDATA[v = inlet_v;
paramlsb = attr_paramlsb;
parammsb = attr_parammsb;

if (v < 0){
	msb = 127;
	msb2 = 127;
	msb3 = 31;
	lsb = 128 + v;
} else  if (v >= 0){

	msb = (v / 128);
	msb2 = (v / 16384);				
	msb3 = (v / 2097152);
	
	lsb = v - ((msb * 128) + (msb2 * 16384) + (msb3 * 2097152));
	
	}

uint8_t sysexArray[14] = {240,0,1,56,0,91,34,parammsb,paramlsb,msb3,msb2,msb,lsb,247}; 

if (inlet_send&&!strig){
	sdWrite(&SDMIDI, sysexArray, 14);
	strig=1;
}

else if (!inlet_send){strig=0;}]]></code.krate>
            </object>
         </patchobj>
         <patchobj type="patch/object" uuid="c43309da-2297-462f-9a81-e11054cb62dd" name="HarmonyRelease" x="602" y="42">
