               <spinner attributeName="paramID" value="219"/>
            </attribs>
            <object id="patch/object" uuid="8c46ef5d-87fa-459c-a88f-6abd842c6668">
               <author>Mattilyn Mattroe</author>
               <license>give me two apple pies and a small fries evry time the object is used in an art installation at the louvre. Otherwise, do as you will</license>
               <helpPatch>LPadPro.axh</helpPatch>
               <inlets>
                  <int32 name="v"/>
               </inlets>
               <outlets/>
               <displays/>
               <params/>
               <attribs>
                  <spinner name="paramID" MinValue="0" MaxValue="20000" DefaultValue="0"/>
               </attribs>
               <includes/>
               <code.declaration><![CDATA[int strig;
int v;
int msb;
int msb2;
int msb3;
int lsb;
int parlsb;
int parmsb;

int prev;]]></code.declaration>
               <code.krate><![CDATA[v = inlet_v;
parmsb = (attr_paramID)/128;
parlsb = attr_paramID - (parmsb * 128);


if (v < 0){
	msb = 127;
	msb2 = 127;
	msb3 = 31;
	lsb = 128 + v;
} else  if (v >= 0){

	msb = (v / 128);
	msb2 = (v / 16384);				
	msb3 = (v / 2097152);
	
	lsb = v - ((msb * 128) + (msb2 * 16384) + (msb3 * 2097152));
	
	}

uint8_t sysexArray[14] = {240,0,1,56,0,91,34,parmsb,parlsb,msb3,msb2,msb,lsb,247}; 


if (inlet_v != prev) {	
sdWrite(&SDMIDI, sysexArray, 14);
prev = inlet_v; 
}]]></code.krate>
            </object>
         </patchobj>
